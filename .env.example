# Copy to .env and fill in. Your .env is git-ignored.

# Your private ntfy.sh push channel. Pick an unguessable name (it IS the access
# control), e.g.: sentinel-$(openssl rand -hex 4). Subscribe to the same topic
# in the ntfy phone app.
NTFY_TOPIC=

# Substring matched against open tab URLs to find the tab to watch.
TARGET_URL_PATTERN=mail.google.com

# Plain-English description of the event you want a phone ping for.
EVENT_DESCRIPTION=a new incoming email arrived in the inbox

# Optional:
# POLL_MS=20000
# CDP_PORT=9222

# Dead-man's switch (recommended for real use): create a free check at
# https://healthchecks.io, paste its ping URL here. The watcher hits it every
# poll; if it goes quiet past the grace period, healthchecks alerts you.
# HEARTBEAT_URL=https://hc-ping.com/your-uuid

# Noise filter: changed lines matching this regex are dropped before Claude is
# called (clocks, counters, ads). Example: [0-9]+ (minutes|seconds) ago|^Ad\b
# IGNORE_REGEX=
